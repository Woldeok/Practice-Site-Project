<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - 상세페이지</title>
    <!-- 부트스트랩 CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            padding-top: 20px;
        }
        .product-container {
            margin-top: 50px;
        }
        .product-details {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
        }
        .product-image {
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body>
    <header class="bg-primary text-white p-3">
        <div class="container d-flex justify-content-between align-items-center">
            <h1>팜앤베리</h1>
            <nav>
                <a href="#" class="text-white mr-3">소개</a>
                <a href="#" class="text-white mr-3">게시판</a>
                <a href="#" class="text-white mr-3">상점</a>
                <a href="#" class="text-white mr-3">메뉴1</a>
                <a href="/login" class="text-white mr-3">로그인</a>
                <a href="/signup" class="text-white">회원가입</a>
            </nav>
        </div>
    </header>

    <div class="container product-container">
        <h2 class="text-center"><%= product.name %> - 상세페이지</h2>
        <div class="row">
            <div class="col-md-6">
                <% if (productDetails.image) { %>
                    <img src="/uploads/<%= productDetails.image %>" alt="<%= product.name %>" class="product-image">
                <% } else { %>
                    <div class="product-image bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 400px;">
                        이미지 없음
                    </div>
                <% } %>
            </div>
            <div class="col-md-6">
                <div class="product-details">
                    <h4>상품명: <%= product.name %></h4>
                    <p><strong>가격:</strong> <%= product.price %>원</p>
                    <p><strong>상품 설명:</strong> <%= productDetails.description %></p>
                    <button class="btn btn-primary">구매하기</button>
                    <button class="btn btn-secondary">장바구니에 담기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 부트스트랩 JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
